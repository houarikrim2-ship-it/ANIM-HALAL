# Bind all interfaces (required for Render/Railway/Fly.io port probes).
# Pin HOST=127.0.0.1 only for local-only development.
HOST=0.0.0.0
PORT=3001
UPSTREAM_ALLOWED_HOSTS=uqload.io,uqload.is,uqload.vc,share4max.com,anime4up.rest,w1.anime4up.rest,4d.h6m1c9q.shop,streamwish.com,streamwish.to,vidas.su,yonaplay.net
UPSTREAM_ALLOW_SUBDOMAINS=true
UPSTREAM_TIMEOUT_MS=20000
UPSTREAM_MAX_REDIRECTS=3
MAX_MANIFEST_BYTES=5242880

# Transient-failure retry policy (408/429/5xx, network errors, timeouts):
# exponential backoff up to UPSTREAM_RETRY_MAX_ATTEMPTS extra attempts
# (0 disables retries). 400/401/403/404/416 and client disconnects are never
# retried.
UPSTREAM_RETRY_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_MS=500
UPSTREAM_RETRY_MAX_DELAY_MS=8000

# Post-DNS SSRF validation is ALWAYS ON: every address an allowlisted host
# resolves to is re-checked against the forbidden-address rules before the
# connection is made, and connections are pinned to the validated addresses.
# Do NOT set UPSTREAM_ALLOW_PRIVATE_RESOLUTION in production — it is a
# test-harness-only override for fake loopback upstreams.

# Server-side per-host provider policy (spec §6): JSON map of host -> headers.
# Applied by the relay before each upstream request and ALWAYS overriding any
# client-declared playback headers. Only User-Agent, Referer and Origin are
# honored; the policy is configured by the operator, never by clients.
# UPSTREAM_PROVIDER_HEADERS={"streamwish.com":{"User-Agent":"Mozilla/5.0","Referer":"https://anime4up.rest/","Origin":"https://anime4up.rest"}}

# Anime source-resolution layer
# Self-hosted MiruroAPI instance (https://github.com/Shineii86/MiruroAPI).
# The public instance (https://mirurotvapi.vercel.app) may be paused; deploy
# your own and point ANIME_API_BASE_URL at it.
ANIME_API_BASE_URL=https://mirurotvapi.vercel.app
ANIME_JIKAN_BASE_URL=https://api.jikan.moe/v4
ANIME_PROVIDER_ENABLED=true
ANIME_JIKAN_ENABLED=true
ANIME_PROVIDER_TIMEOUT_MS=15000
ANIME_MAX_ATTEMPTS=2
ANIME_PROVIDER_PRIORITY=kiwi,pewe,bee,bonk,bun,ally,nun,twin,cog,moo,hop,telli
ANIME_CACHE_MAX_ENTRIES=500
ANIME_SEARCH_CACHE_TTL_MS=60000
ANIME_INFO_CACHE_TTL_MS=300000
ANIME_EPISODES_CACHE_TTL_MS=120000

# HTML scraper fallback chain (used only when MiruroAPI yields no sources).
# The backend fetches these sites with browser-like headers, extracts only
# directly playable media URLs and serves them through the HLS relay, which
# re-validates hosts against UPSTREAM_ALLOWED_HOSTS at playback time. The
# Android client never contacts these hosts. Anti-bot challenges are never
# bypassed: challenge pages are classified UPSTREAM_BLOCKED and skipped.
ANIME_SCRAPER_ENABLED=false
ANIME_WITANIME_BASE_URL=https://witanime.com
ANIME_ANIME4UP_BASE_URL=https://anime4up.rest
ANIME_SCRAPER_TIMEOUT_MS=12000
ANIME_SCRAPER_PRIORITY=witanime,anime4up

# Multi-server embed extractors (StreamWish / Vidas / YonaPlay).
# (DEPRECATED: Refactored to Client-Side Extraction in Android app)
ANIME_EMBED_FOLLOW_ENABLED=false
ANIME_EXTRACTOR_TIMEOUT_MS=10000